{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robdor80.github.io/CoreRPG/schemas/content/0.1.0/resource-definition.schema.json",
  "title": "CoreRPG Resource Definition 0.1.0",
  "type": "object",
  "properties": {
    "$schema": {
      "const": "https://robdor80.github.io/CoreRPG/schemas/content/0.1.0/resource-definition.schema.json"
    },
    "id": {
      "$ref": "types.schema.json#/$defs/definitionId"
    },
    "kind": {
      "$ref": "types.schema.json#/$defs/resourceKind"
    },
    "references": {
      "type": "array",
      "items": {
        "$ref": "types.schema.json#/$defs/definitionReference"
      },
      "uniqueItems": true
    }
  },
  "required": [
    "id",
    "kind",
    "references"
  ],
  "additionalProperties": false
}
